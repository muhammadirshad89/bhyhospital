# Copy to .env.local for local development. Never commit real secrets.
# None of these are secrets. All are read at build time, so redeploy after changing them.

# Your public domain, no trailing slash (for example https://www.your-domain.example).
# Used for canonical URLs, Open Graph, sitemap.xml, robots.txt and structured data.
# If left empty on Vercel, the project's Vercel production domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# The site is INDEXABLE by default. Set to "true" only to block all search engines
# (for example on a staging site). On Vercel, Preview and Development deployments are
# always blocked automatically; only the Production deployment is indexable.
SITE_NOINDEX=

# Draft/placeholder sections (for example the unwritten About Us panels) are hidden unless this is "true".
SHOW_PLACEHOLDER_CONTENT=
