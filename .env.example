# Copy to .env.local for local development. Never commit real secrets.

# Confirmed production domain, no trailing slash. Used for canonical URLs,
# Open Graph, sitemap and structured data. Leave empty until the domain is confirmed.
# Example (not confirmed): NEXT_PUBLIC_SITE_URL=https://www.example.org
NEXT_PUBLIC_SITE_URL=

# While "true" (the default when unset) the site shows clearly labelled placeholder
# records, a preview banner, and blocks search engines (noindex + robots Disallow).
# Set to "false" ONLY when real, verified content has replaced the placeholders.
SHOW_PLACEHOLDER_CONTENT=true
