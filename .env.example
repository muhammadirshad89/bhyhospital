# Copy to .env.local for local development. Never commit real secrets.
# None of these are secrets. All are read at build time, so redeploy after changing them.

# Your public domain, no trailing slash (for example https://www.your-domain.example).
# Used for canonical URLs, Open Graph, sitemap.xml, robots.txt and structured data.
# If left empty on Vercel, the project's Vercel production domain is used automatically.
NEXT_PUBLIC_SITE_URL=

# The site is INDEXABLE by default. Set to "true" only to block all search engines
# (for example on a staging site). On Vercel, Preview and Development deployments are
# always blocked automatically; only the Production deployment is indexable.
SITE_NOINDEX=

# Draft/placeholder sections (for example the unwritten About Us panels) are hidden unless this is "true".
SHOW_PLACEHOLDER_CONTENT=

# ---- Admin panel and doctor leave management (see docs/ADMIN-SETUP.md) ----
# PostgreSQL (Prisma Postgres). Server-side secrets: set them in Vercel > Project > Settings > Environment Variables
# (never as NEXT_PUBLIC_...), and never commit real values. The website decides which one is POOLED and which is DIRECT
# from the HOST NAME in the string, not from the variable name:
#   pooled  host  pooled.db.prisma.io  -> used by the running website
#   direct  host  db.prisma.io         -> used only by `npm run db:migrate` and `npm run admin:create`
# Variables read, in priority order (blank ones are ignored):
#   website:  DATABASE_URL_POOLED, POSTGRES_URL_POOLED, POSTGRES_URL, DATABASE_URL   (first one with a pooled host)
#   commands: DATABASE_URL_DIRECT, DIRECT_URL, POSTGRES_URL_NON_POOLING, DATABASE_URL_UNPOOLED, then the website ones (first one with a direct host)
# Without any of them the public website works exactly as before and simply shows no leave information.
DATABASE_URL=
DATABASE_URL_POOLED=
DATABASE_URL_DIRECT=
# Optional: connections per server instance (1-10, default 3).
# DATABASE_POOL_MAX=3
